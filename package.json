{
  "name": "bot-shield",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "dev:db:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:db:setup": "docker compose -f docker-compose.dev.yml up -d && npm run setup",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node server.js",
    "start:router": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:generate:safe": "node scripts/prisma-generate-safe.mjs",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test:mvp": "node --test tests/*.test.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "dependencies": {
    "@mjackson/node-fetch-server": "^0.2.0",
    "@prisma/client": "^6.19.2",
    "@react-router/dev": "^7.18.0",
    "@react-router/fs-routes": "^7.18.0",
    "@react-router/node": "^7.18.0",
    "@react-router/serve": "^7.18.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-api": "^13.0.0",
    "@shopify/shopify-app-react-router": "^1.2.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.1",
    "express": "^4.22.2",
    "isbot": "^5.1.31",
    "morgan": "^1.11.0",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.37.0",
    "react-router": "^7.18.0",
    "three": "^0.183.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1"
  },
  "author": "tirup"
}
