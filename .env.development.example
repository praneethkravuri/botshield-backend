# Local development environment template.
# Copy to `.env` for local work. Never commit `.env`.
#
# IMPORTANT:
# - Do not paste the Render production DATABASE_URL here.
# - Do not copy production customer or protected data into the local database.
# - Use synthetic/test store data only.

NODE_ENV=development

# Local Docker PostgreSQL from docker-compose.dev.yml
DATABASE_URL=postgresql://botshield:botshield_dev@localhost:5432/botshield_dev

# Shopify CLI will also populate these when you run `npm run dev`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
APP_URL=
SCOPES=write_app_proxy

# Optional local UI preview mode with in-memory sessions and mock data.
BOTSHIELD_UI_PREVIEW=0
