<div
  id="botshield-storefront-root"
  data-decision-url="/apps/botshield/decision"
  data-blocked-url="/apps/botshield/blocked"
  data-path="{{ request.path }}"
  data-official-logo-url="{{ 'botshield-official-logo-transparent.png' | asset_url }}"
  data-storefront-build="botshield-14"
></div>

{% schema %}
{
  "name": "BotShield",
  "target": "body",
  "stylesheet": "botshield.css",
  "javascript": "botshield.js",
  "settings": []
}
{% endschema %}
